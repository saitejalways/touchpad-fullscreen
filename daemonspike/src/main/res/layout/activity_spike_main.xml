<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="#F2F2F2"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tokenText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#D6D6D6"
            android:textSize="16sp"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/pairing_section_title"
            android:textColor="#F2F2F2"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/pairPortInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:autofillHints=""
            android:backgroundTint="#A0A0A0"
            android:hint="@string/pair_port_hint"
            android:inputType="number"
            android:textColor="#F2F2F2"
            android:textColorHint="#9A9A9A" />

        <EditText
            android:id="@+id/pairCodeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:autofillHints=""
            android:backgroundTint="#A0A0A0"
            android:hint="@string/pair_code_hint"
            android:inputType="number"
            android:textColor="#F2F2F2"
            android:textColorHint="#9A9A9A" />

        <Button
            android:id="@+id/pairButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/pair_button" />

        <Button
            android:id="@+id/launchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/launch_daemon" />

        <Button
            android:id="@+id/checkTargetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/check_target" />

        <Button
            android:id="@+id/pingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ping_once" />

        <Button
            android:id="@+id/startMonitorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/start_monitor" />

        <Button
            android:id="@+id/stopMonitorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/stop_monitor" />

        <Button
            android:id="@+id/stopDaemonButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/stop_daemon" />

        <Button
            android:id="@+id/resetTokenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/reset_token" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#F2F2F2"
            android:textSize="15sp"
            android:textIsSelectable="true" />
    </LinearLayout>

</ScrollView>
