<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="14dp"
        android:background="@drawable/bg_steel_panel"
        android:theme="@style/ThemeOverlay.Touchpad.SteelPanel"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scroll_settings_label"
            android:textColor="#11161B"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/scroll_sensitivity_label" />

        <EditText
            android:id="@+id/scrollSensitivityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/scroll_sensitivity_hint"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/vertical_followup_factor_label" />

        <EditText
            android:id="@+id/verticalFollowupFactorInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/vertical_followup_factor_hint"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/horizontal_scroll_sensitivity_label" />

        <EditText
            android:id="@+id/horizontalScrollSensitivityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/horizontal_scroll_sensitivity_hint"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/horizontal_followup_factor_label" />

        <EditText
            android:id="@+id/horizontalFollowupFactorInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/horizontal_followup_factor_hint"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/two_finger_scroll_grace_label" />

        <EditText
            android:id="@+id/twoFingerScrollGraceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/two_finger_scroll_grace_hint"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/sync_interval_label" />

        <EditText
            android:id="@+id/syncIntervalInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/sync_interval_hint"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/edge_scroll_repeat_delay_label" />

        <EditText
            android:id="@+id/edgeScrollRepeatDelayInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/edge_scroll_repeat_delay_hint"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/edge_scroll_jump_multiplier_label" />

        <EditText
            android:id="@+id/edgeScrollJumpMultiplierInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/edge_scroll_jump_multiplier_hint"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/scroll_dispatch_interval_label" />

        <EditText
            android:id="@+id/scrollDispatchIntervalInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/scroll_dispatch_interval_hint"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/fling_duration_label" />

        <EditText
            android:id="@+id/flingDurationInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/fling_duration_hint"
            android:inputType="number"
            android:maxLines="1" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/invertHorizontalScrollSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/invert_horizontal_scroll_toggle" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/invertVerticalScrollSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/invert_vertical_scroll_toggle" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/oneFingerEdgeScrollSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/one_finger_edge_scroll_toggle" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/invertEdgeHorizontalScrollSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/invert_edge_horizontal_scroll_toggle" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/invertEdgeVerticalScrollSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/invert_edge_vertical_scroll_toggle" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sideEdgeScrollSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/side_edge_scroll_toggle" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/restoreCursorAfterEdgeScrollSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/restore_cursor_after_edge_scroll_toggle" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/made_by_footer" />

    </LinearLayout>
</ScrollView>
