<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="14dp"
        android:background="@drawable/bg_steel_panel"
        android:theme="@style/ThemeOverlay.Touchpad.SteelPanel"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/system_behavior_settings_label"
            android:textColor="#11161B"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/bottomNavPassthroughSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/bottom_nav_passthrough_toggle" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/autoStartOnBootSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auto_start_on_boot_toggle" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/debugOverlaySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/debug_overlay_toggle" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/quickToggleOverlaySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/quick_toggle_overlay_toggle" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/quickToggleRightAutoRotateSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/quick_toggle_right_auto_rotate_toggle" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/made_by_footer" />

    </LinearLayout>
</ScrollView>
