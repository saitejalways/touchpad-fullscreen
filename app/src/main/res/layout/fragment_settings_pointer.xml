<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="14dp"
        android:background="@drawable/bg_steel_panel"
        android:theme="@style/ThemeOverlay.Touchpad.SteelPanel"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pointer_settings_label"
            android:textColor="#11161B"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/mouse_sensitivity_label" />

        <EditText
            android:id="@+id/mouseSensitivityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/mouse_sensitivity_hint"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/mouseAccelerationSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/mouse_acceleration_toggle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/hid_move_chunk_size_label" />

        <EditText
            android:id="@+id/hidMoveChunkSizeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/hid_move_chunk_size_hint"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/pointer_move_deadband_label" />

        <EditText
            android:id="@+id/pointerMoveDeadbandInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/pointer_move_deadband_hint"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <Button
            android:id="@+id/calibrateCursorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tech_button_neutral"
            android:text="@string/calibrate_cursor_button"
            android:textColor="#11161B"
            android:textStyle="bold" />

        <Button
            android:id="@+id/clearCalibrationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tech_button_neutral"
            android:text="@string/clear_calibration_button"
            android:textColor="#11161B"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/made_by_footer" />

    </LinearLayout>
</ScrollView>
