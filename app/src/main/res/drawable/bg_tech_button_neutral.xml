<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="#4B545E" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape>
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:centerColor="#B9C1C8"
                android:endColor="#7B858F"
                android:startColor="#F1F5F9" />
            <stroke
                android:width="2dp"
                android:color="#4E5862" />
            <padding
                android:left="16dp"
                android:top="12dp"
                android:right="16dp"
                android:bottom="12dp" />
        </shape>
    </item>
</layer-list>
