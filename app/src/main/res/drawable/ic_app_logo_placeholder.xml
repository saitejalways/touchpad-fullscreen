<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:centerColor="#C4CBD3"
                android:endColor="#6B7580"
                android:startColor="#F3F7FA" />
            <stroke
                android:width="2dp"
                android:color="#4A5561" />
        </shape>
    </item>
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient
                android:angle="270"
                android:centerColor="#36404A"
                android:endColor="#161B20"
                android:startColor="#5B6671" />
        </shape>
    </item>
    <item
        android:left="11dp"
        android:top="11dp"
        android:right="11dp"
        android:bottom="11dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:centerColor="#9FB6CA"
                android:endColor="#617C93"
                android:startColor="#E7F1F8" />
        </shape>
    </item>
</layer-list>
